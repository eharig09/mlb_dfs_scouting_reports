__pycache__/
*.py[cod]
*.pyo

.venv/
venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
.matplotlib/
# The dashboard is deployed from this repo and reads the report payloads at runtime, so
# `.cache/report_data/` is tracked. Everything else under `.cache/` is derived and large --
# `statcast_chunk/` alone runs to tens of gigabytes -- so the directory is excluded by
# contents (`.cache/*`) rather than as a whole: a trailing-slash ignore stops git descending
# at all, and a negation inside it would never be reached.
.cache/*
!.cache/report_data/

plots/
scouting_reports/
savant_highlights/

dfs_boards/
# Salary exports are the dashboard's other runtime input (Value page, price tiers, the slate
# filter), so they ship. Pool files are not read by the app and carry hand-made lock and
# exclude decisions, so they stay out.
dfs_daily_files/*
!dfs_daily_files/DKSalaries_*.csv
dfs/salaries/

DejaVuSans.pkl
StreamFinder.txt
pitcher_report.csv
scripts/top_5_stuff_plus_per_pitch_type.*

*.pdf
*.png
*.jpg
*.jpeg

.env
.env.*
!.env.example

autosnap.log

# NFL slate reports (generated)
nfl/nfl_reports/
nfl/nfl_dfs/

.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Generated analysis output. `dfs_analysis/` alone is 120 MB and holds a single
# 103 MB file, past GitHub's hard per-file limit; all of it is reproducible by
# re-running the pipeline.
# ---------------------------------------------------------------------------
dfs_analysis/
logs/

# Third-party data pulled from elsewhere: projections, PFF grades, snap counts
# and strength-of-schedule tables. Inputs, not source, and not ours to publish.
ROS_projections/
SOS/
pff/
pff_coverage_data/
snap_counts/
